# operations-agent environment configuration
# Copy to .dev.vars and fill in actual values.
# .dev.vars is gitignored — never commit credentials.

# Meshd port (assigned by infrastructure-agent)
MESHD_PORT=8081

# Infrastructure agent endpoint (for health checks, status)
INFRA_AGENT_URL=http://localhost:7700

# Compositor deploy target (Cloudflare Worker)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Zulip notifications (optional)
ZULIP_URL=
ZULIP_EMAIL=
ZULIP_API_KEY=

# SSH host for the agent deployment machine (used by ops scripts)
AGENT_SSH_HOST=localhost
AGENT_SSH_PORT=22

# Base directory where agent projects live on the remote host
# Scripts derive per-agent paths from this (e.g., $AGENT_BASE_DIR/psychology)
AGENT_BASE_DIR=/home/user/projects
