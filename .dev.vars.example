# operations-agent environment configuration
# Copy to .dev.vars and fill in actual values.
# .dev.vars is gitignored — never commit credentials.

# Meshd port (assigned by infrastructure-agent)
MESHD_PORT=8081

# Infrastructure agent endpoint (for health checks, status)
INFRA_AGENT_URL=http://localhost:7700

# Compositor deploy target (Cloudflare Worker)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Zulip notifications (optional)
ZULIP_URL=
ZULIP_EMAIL=
ZULIP_API_KEY=

# Jenkins Forge (optional — CI/CD pipeline)
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=

# Cloudflare DNS (optional — subdomain management)
CLOUDFLARE_DNS_TOKEN=

# KV namespace for self-observation (same-zone SPOF elimination)
# AUTH_KV namespace shared with compositor Worker
KV_NAMESPACE_ID=

# SSH host for the agent deployment machine (used by meshctl)
# Set to "localhost" when running on the deployment machine itself
AGENT_SSH_HOST=localhost
AGENT_SSH_PORT=22

# Base directory where agent projects live on the remote host
# Scripts derive per-agent paths from this (e.g., $AGENT_BASE_DIR/psychology)
AGENT_BASE_DIR=/home/user/projects

# Claude spawn command (meshd uses this to invoke Claude contexts)
# Point to claude binary or a wrapper script that sets PATH
SPAWN_COMMAND=claude

# Spawn timeout in seconds (max wall-clock time per Claude invocation)
SPAWN_TIMEOUT=300

# Safety-net poll interval in seconds (Gc handles routine checks;
# this fires only as a safety net — 30 minutes default)
POLL_INTERVAL=1800

# Max concurrent Claude spawns across mesh (normal capacity)
MAX_CONCURRENT_SPAWNS=1

# Deliberation model — which Claude model meshd spawns use
# sonnet = balanced (default), opus = deep reasoning, haiku = fast/cheap
DELIBERATION_MODEL=sonnet

# Reserve slots — extra capacity unlocked by touching /tmp/mesh-reserve-unlock
# Total cap when reserve active: MAX_CONCURRENT_SPAWNS + MESH_RESERVE_SLOTS
MESH_RESERVE_SLOTS=2

# GitHub webhook HMAC secret (for meshd webhook verification)
GITHUB_WEBHOOK_SECRET=

# Log level (debug, info, warn, error)
LOG_LEVEL=info
