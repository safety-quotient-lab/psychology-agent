{
  "$schema": "cogarch-config/v1",

  "system_classification": "embedded cognitive system",
  "methodology": {
    "name": "systems thinking",
    "references": ["von Bertalanffy, 1968", "Meadows, 2008"],
    "principles": {
      "structural": "Domain-Driven Design (Evans, 2003)",
      "expression": "Literate programming (Knuth, 1984, adapted: A+C)",
      "deployment": "Embedded system principles"
    }
  },

  "identity": {
    "agent_id": "operations-agent",
    "display_name": "Operations Agent",
    "role": "Operational coordination, compositor ownership, shared vocabulary governance for the safety-quotient mesh",
    "description": "Orchestrates mesh-wide operational concerns: compositor UI, agent discovery, vocabulary standardization, and operational dashboards. Owns the interagent compositor Worker on Cloudflare.",
    "model": "claude-opus-4-6",
    "instance_label": "Claude Code (Opus 4.6), Linux amd64",
    "stance": "socratic",
    "schemas_supported": ["interagent/v1", "command-request/v1", "local-coordination/v1"],
    "capabilities": [
      "compositor-management",
      "vocabulary-governance",
      "agent-discovery",
      "operational-dashboards",
      "mesh-coordination"
    ]
  },

  "organization": {
    "name": "Safety Quotient Lab",
    "github_handle": "safety-quotient-lab",
    "url": "https://github.com/safety-quotient-lab",
    "primary_repo": "operations-agent",
    "documentation_url": "https://github.com/safety-quotient-lab/operations-agent"
  },

  "infrastructure": {
    "worker_url": "https://api.safety-quotient.dev",
    "worker_agent_card_path": "/.well-known/agent-card.json",
    "production_endpoint": "https://operations-agent.safety-quotient.dev",
    "hosting": {
      "provider": "Cloudflare Workers",
      "note": "Compositor Worker serves interagent UI, WebFinger, agent registry"
    }
  },

  "scoring_subsystem": {
    "enabled": false
  },

  "peers": {
    "agents": {
      "psychology-agent": {
        "repo": "safety-quotient-lab/psychology-agent",
        "role": "domain-knowledge-provider",
        "card_url": "https://psychology-agent.safety-quotient.dev/.well-known/agent-card.json"
      },
      "psq-agent": {
        "repo": "safety-quotient-lab/safety-quotient",
        "role": "psq-scoring",
        "card_url": "https://psq-agent.safety-quotient.dev/.well-known/agent-card.json"
      },
      "unratified-agent": {
        "repo": "safety-quotient-lab/unratified",
        "role": "advocacy-publisher",
        "card_url": "https://unratified.org/.well-known/agent-card.json"
      },
      "observatory-agent": {
        "repo": "safety-quotient-lab/observatory",
        "role": "data-observatory",
        "card_url": "https://observatory.unratified.org/.well-known/agent-card.json"
      }
    },
    "outbound_routing_domains": ["operations", "coordination", "vocabulary"]
  },

  "transport": {
    "method": "git-PR",
    "repo_url": "https://github.com/safety-quotient-lab/operations-agent",
    "sessions_path": "transport/sessions/",
    "manifest_path": "transport/MANIFEST.json",
    "naming_convention": "transport/sessions/{session-name}/{direction}-{descriptor}-{sequence}.json",
    "agent_card_path": ".well-known/agent-card.json"
  },

  "facets": {
    "topic_domain_map": {
      "decisions": "design",
      "cogarch": "cognitive-architecture",
      "compositor": "ui",
      "vocabulary": "governance",
      "discovery": "mesh"
    },
    "default_domain": "operations",
    "agent_detection_patterns": {
      "patterns": [],
      "default_agent": "operations-agent"
    }
  },

  "domain_content": {
    "domain_docs": [
      "interagent/vocab.json",
      "plan.md"
    ],
    "domain_constructs": [
      "compositor — Cloudflare Worker serving interagent UI",
      "vocabulary — shared term definitions across mesh agents",
      "agent-card — A2A-compatible agent discovery document"
    ]
  }
}
